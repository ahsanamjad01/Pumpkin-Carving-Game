    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "37f5e15c753d4ab7bd2fe64a95b2592a",
    "m_Title": "GetAverageCurvature",
    "m_Content": "This is the HLSL code where all the magic happens. We sample normals from the buffer to determine the curvature (concave or convex) of each pixel. We then output a value between 0 and 1, where 0.5 means no curvature at all.",
